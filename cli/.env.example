# SHIELD CLI Environment Variables

# Pinata JWT for IPFS uploads (required for creating policies)
# Get this from your Pinata dashboard: https://app.pinata.cloud
PINATA_API_KEY=your_pinata_jwt_here

# Optional: Custom API URL (defaults to http://localhost:3002/api/v1)
# SHIELD_API_URL=https://developer.shieldhq.xyz/api/v1
